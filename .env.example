# Cache directory (default: ~/.cache/bcb-mcp)
BCB_MCP_CACHE_DIR=/home/user/.cache/bcb-mcp

# HTTP behaviour
BCB_MCP_TIMEOUT=60
BCB_MCP_MAX_RETRIES=3
BCB_MCP_MIN_INTERVAL=0.2
BCB_MCP_MAX_CONCURRENCY=4

# Default observations kept per series
BCB_MCP_MAX_ROWS=5000

# Server transport defaults
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
LOG_LEVEL=INFO
